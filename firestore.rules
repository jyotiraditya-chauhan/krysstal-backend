rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /admins/{userId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || request.auth.token.role == 'Admin');
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}